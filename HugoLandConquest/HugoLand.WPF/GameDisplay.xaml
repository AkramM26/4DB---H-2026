<Window x:Class="HugoLand.WPF.GameDisplay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HugoLand - Game" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="8">
        <Border DockPanel.Dock="Top" Background="#EEE" Padding="6" Margin="0,0,0,6">
            <TextBlock x:Name="txtStatus" FontSize="14" FontWeight="Bold"
                       Text="Loading..." TextWrapping="Wrap"/>
        </Border>

        <!-- Message log -->
        <Border DockPanel.Dock="Bottom" Background="#F8F8F8" Padding="6" Height="120" Margin="0,6,0,0">
            <ScrollViewer x:Name="scrLog" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="txtLog" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
            </ScrollViewer>
        </Border>

        <!-- Right action panel -->
        <StackPanel DockPanel.Dock="Right" Width="280" Margin="8,0,0,0">

            <!-- Main actions -->
            <StackPanel x:Name="pnlMainActions" Visibility="Collapsed">
                <TextBlock Text="Turn actions" FontWeight="Bold" Margin="0,0,0,6"/>
                <Button Content="Select an army" Margin="0,2" Padding="4" Click="btnSelectArmy_Click"/>
                <Button Content="Save Game" Margin="0,2" Padding="4" Click="btnSaveGame_Click"/>
                <Button Content="Go to Main Menu" Margin="0,2" Padding="4" Click="btnMainMenu_Click"/>
                <Button Content="End Turn" Margin="0,2" Padding="4" Click="btnEndTurn_Click"/>
            </StackPanel>

            <!-- Army selection -->
            <StackPanel x:Name="pnlArmySelect" Visibility="Collapsed">
                <TextBlock Text="Select one of your armies" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="Click on a cell, or enter coordinates:" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Label Content="X:" Width="24"/>
                    <TextBox x:Name="txtArmyX" Width="50"/>
                    <Label Content="Y:" Width="24" Margin="8,0,0,0"/>
                    <TextBox x:Name="txtArmyY" Width="50"/>
                </StackPanel>
                <Button Content="Confirm" Margin="0,4" Padding="4" Click="btnArmySelectConfirm_Click"/>
                <Button Content="Cancel" Margin="0,2" Padding="4" Click="btnArmySelectCancel_Click"/>
            </StackPanel>

            <!-- Army actions -->
            <StackPanel x:Name="pnlArmyActions" Visibility="Collapsed">
                <TextBlock x:Name="txtArmyInfo" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <Button Content="Move" Margin="0,2" Padding="4" Click="btnArmyAct_Click" Tag="1"/>
                <Button Content="Build a camp (20g)" Margin="0,2" Padding="4" Click="btnArmyAct_Click" Tag="2"/>
                <Button Content="Convert to fortification (50g)" Margin="0,2" Padding="4" Click="btnArmyAct_Click" Tag="3"/>
                <Button Content="Reinforce (2g/soldier)" Margin="0,2" Padding="4" Click="btnArmyAct_Click" Tag="4"/>
                <Button Content="Split the army" Margin="0,2" Padding="4" Click="btnArmyAct_Click" Tag="5"/>
                <Button Content="Pass" Margin="0,2" Padding="4" Click="btnArmyAct_Click" Tag="6"/>
            </StackPanel>

            <!-- Move direction -->
            <StackPanel x:Name="pnlMove" Visibility="Collapsed">
                <TextBlock x:Name="txtMoveInfo" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <Button Content="North" Margin="0,2" Padding="4" Click="btnMoveDir_Click" Tag="N"/>
                <Button Content="South" Margin="0,2" Padding="4" Click="btnMoveDir_Click" Tag="S"/>
                <Button Content="East" Margin="0,2" Padding="4" Click="btnMoveDir_Click" Tag="E"/>
                <Button Content="West" Margin="0,2" Padding="4" Click="btnMoveDir_Click" Tag="W"/>
                <Button Content="Cancel" Margin="0,4" Padding="4" Click="btnMoveDir_Click" Tag="X"/>
            </StackPanel>

            <!-- Number input -->
            <StackPanel x:Name="pnlNumber" Visibility="Collapsed">
                <TextBlock x:Name="txtNumberPrompt" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBox x:Name="txtNumber" Margin="0,2"/>
                <Button Content="OK" Margin="0,4" Padding="4" Click="btnNumberOk_Click"/>
                <Button Content="Cancel" Margin="0,2" Padding="4" Click="btnNumberCancel_Click"/>
            </StackPanel>

            <!-- Victory -->
            <StackPanel x:Name="pnlVictory" Visibility="Collapsed">
                <TextBlock x:Name="txtVictory" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Button Content="Return to Main Menu" Padding="4" Click="btnVictoryOk_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Board -->
        <Border BorderBrush="Black" BorderThickness="1">
            <Grid x:Name="grdBoard" Background="White"/>
        </Border>
    </DockPanel>
</Window>
