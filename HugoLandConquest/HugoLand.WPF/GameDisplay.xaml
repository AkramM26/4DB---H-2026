<Window x:Class="HugoLand.WPF.GameDisplay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HugoLand - Game" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        TextElement.Foreground="#E0E0E0">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MyBorder"
                                BorderThickness="3"
                                CornerRadius="15"
                                Background="Transparent">
                            <Border.BorderBrush>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="Black"/>
                                    <GradientStop Color="White" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="MyBorder" Value="Gray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="8">


        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Border x:Name="brdTurnBanner" Background="#2F6FDB" Padding="8" Margin="0,0,0,6" CornerRadius="4">
                <StackPanel>
                    <TextBlock x:Name="txtTurnBanner" FontSize="18" FontWeight="Bold" Foreground="White"
                               Text="Player 1 turn" TextWrapping="Wrap"/>
                    <TextBlock x:Name="txtTurnPrompt" FontSize="12" Foreground="White"
                               Text="Select an army or choose an action" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="3" Padding="6">
                <TextBlock x:Name="txtStatus" FontSize="14" FontWeight="Bold"
                           Text="Loading..." TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Message log -->
        <Border DockPanel.Dock="Bottom" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" CornerRadius="3" Padding="6" Height="120" Margin="0,6,0,0">
            <ScrollViewer x:Name="scrLog" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="txtLog" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Foreground="#CCCCCC"/>
            </ScrollViewer>
        </Border>

        <!-- Right action panel -->
        <Border DockPanel.Dock="Right" Width="280" Margin="8,0,0,0" BorderBrush="#333333" BorderThickness="1" CornerRadius="3" Padding="10">
            <Border.Background>
                <ImageBrush ImageSource="/img/vs.jpg"/>
            </Border.Background>
            <StackPanel>
                <StackPanel Width="280" Margin="8,0,0,0" TextElement.Foreground="White">


                    <!-- Main actions -->
                    <StackPanel x:Name="pnlMainActions" Visibility="Collapsed" TextElement.Foreground="White">
                        <TextBlock Text="Turn actions" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Button Content="Select an army" Margin="0,2" Padding="4" Click="btnSelectArmy_Click"/>
                        <Button Content="Save Game" Margin="0,2" Padding="4" Click="btnSaveGame_Click"/>
                        <Button Content="Go to Main Menu" Margin="0,2" Padding="4" Click="btnMainMenu_Click"/>
                        <Button Content="End Turn" Margin="0,2" Padding="4" Click="btnEndTurn_Click"/>
                    </StackPanel>

                    <!-- Army selection -->
                    <StackPanel x:Name="pnlArmySelect" Visibility="Collapsed">
                        <TextBlock Text="Select one of your armies" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="Click a highlighted army on the map, or enter coordinates as a fallback:" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Label Content="X:" Foreground="White" Width="24"/>
                            <TextBox x:Name="txtArmyX" Width="50"/>
                            <Label Content="Y:" Width="24" Foreground="White" Margin="8,0,0,0"/>
                            <TextBox x:Name="txtArmyY" Width="50"/>
                        </StackPanel>
                        <Button Content="Confirm" Margin="0,4" Padding="4" Click="btnArmySelectConfirm_Click"/>
                        <Button Content="Cancel" Margin="0,2" Padding="4" Click="btnArmySelectCancel_Click"/>
                    </StackPanel>

                    <!-- Army actions -->
                    <StackPanel x:Name="pnlArmyActions" Visibility="Collapsed">
                        <TextBlock x:Name="txtArmyInfo" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <Button x:Name="btnMoveAction" Content="Move" Margin="0,2" Padding="4" Click="btnArmyAct_Click" Tag="1"/>
                        <Button x:Name="btnBuildCampAction" Content="Build a camp (20g)" Margin="0,2" Padding="4" Click="btnArmyAct_Click" Tag="2"/>
                        <Button x:Name="btnUpgradeCampAction" Content="Convert to fortification (50g)" Margin="0,2" Padding="4" Click="btnArmyAct_Click" Tag="3"/>
                        <Button x:Name="btnReinforceAction" Content="Reinforce (2g/soldier)" Margin="0,2" Padding="4" Click="btnArmyAct_Click" Tag="4"/>
                        <Button x:Name="btnSplitArmyAction" Content="Split the army" Margin="0,2" Padding="4" Click="btnArmyAct_Click" Tag="5"/>
                        <Button x:Name="btnPassArmyAction" Content="Pass" Margin="0,2" Padding="4" Click="btnArmyAct_Click" Tag="6"/>
                    </StackPanel>

                    <!-- Move direction -->
                    <StackPanel x:Name="pnlMove" Visibility="Collapsed">
                        <TextBlock x:Name="txtMoveInfo" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <TextBlock Text="Shortcuts: WASD / Arrow keys, Esc to cancel" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Button Content="North" Margin="0,2" Padding="4" Click="btnMoveDir_Click" Tag="N"/>
                        <Button Content="South" Margin="0,2" Padding="4" Click="btnMoveDir_Click" Tag="S"/>
                        <Button Content="East" Margin="0,2" Padding="4" Click="btnMoveDir_Click" Tag="E"/>
                        <Button Content="West" Margin="0,2" Padding="4" Click="btnMoveDir_Click" Tag="W"/>
                        <Button Content="Cancel" Margin="0,4" Padding="4" Click="btnMoveDir_Click" Tag="X"/>
                    </StackPanel>

                    <!-- Number input -->
                    <StackPanel x:Name="pnlNumber" Visibility="Collapsed">
                        <TextBlock x:Name="txtNumberPrompt" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtNumber" Margin="0,2"/>
                        <Button Content="OK" Margin="0,4" Padding="4" Click="btnNumberOk_Click"/>
                        <Button Content="Cancel" Margin="0,2" Padding="4" Click="btnNumberCancel_Click"/>
                    </StackPanel>

                    <!-- Victory -->
                    <StackPanel x:Name="pnlVictory" Visibility="Collapsed">
                        <TextBlock x:Name="txtVictory" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button Content="Return to Main Menu" Padding="4" Click="btnVictoryOk_Click"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Board -->
        <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="3">
            <Grid x:Name="grdBoard"></Grid>
        </Border>
    </DockPanel>
</Window>