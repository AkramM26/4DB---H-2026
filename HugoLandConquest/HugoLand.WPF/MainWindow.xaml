<Window x:Class="HugoLand.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HugoLand Conquest" Height="509" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        ResizeMode="NoResize">



    <Window.Resources>
        <!-- Base button style -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Width" Value="260"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#888888"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quit button style (accent) -->
        <Style x:Key="QuitButton" TargetType="Button" BasedOn="{StaticResource MenuButton}">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/img/MainWidowImg.png" Stretch="UniformToFill"/>
        </Grid.Background>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Height="464">

            <!-- Title -->
            <TextBlock Text="HUGOLAND"
                       FontFamily="Segoe UI"
                       FontSize="28"
                       FontWeight="Light"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>
            <TextBlock Text="CONQUEST"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#555555"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>





            <!-- Menu buttons -->
            <StackPanel Margin="0,20,0,0">
                <Button x:Name="btnNewGame"             Content="New Game"                Style="{StaticResource MenuButton}" Click="btnNewGame_Click" Height="37"/>
                <Button x:Name="btnLoadGame"            Content="Load Game"               Style="{StaticResource MenuButton}" Click="btnLoadGame_Click" Height="37"/>
                <Button x:Name="btnNewGameWithTemplate" Content="New Game With Template"  Style="{StaticResource MenuButton}" Click="btnNewGameWithTemplate_Click" Height="37"/>
                <Button x:Name="btnMapTemplateList"     Content="Edit Map Template"       Style="{StaticResource MenuButton}" Click="btnMapTemplateList_Click" Height="37"/>
                <Button x:Name="btnMapTemplate"         Content="Create Map Template"     Style="{StaticResource MenuButton}" Click="btnMapTemplate_Click" Height="37"/>
                <Button x:Name="btnHistory"         Content="History"     Style="{StaticResource MenuButton}" Height="37" Click="btnHistory_Click"/>
                <Button x:Name="btnQuit"                Content="Quit"                    Style="{StaticResource QuitButton}" Click="btnQuit_Click" Height="37"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
