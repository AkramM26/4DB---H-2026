<Window x:Class="HugoLand.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HugoLand.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Margin" Value="0,10,0,10"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF2D2D2D" Offset="0"/>
                        <GradientStop Color="#FF4A90E2" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Grid>
        <Button x:Name="btnOpenGame" Content="Open Game" HorizontalAlignment="Left" Height="30" Margin="64,148,0,0" VerticalAlignment="Top" Width="114" Click="btnOpenGame_Click"/>
        
        <!--ENTETE-->
        <Border x:Name="bdrTitle" Height="60" VerticalAlignment="Top" Margin="10,5,10,0" CornerRadius="10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF1A1A1A" Offset="0"/>
                    <GradientStop Color="#FF4A90E2" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="320" Opacity="0.5" ShadowDepth="3"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="HugoLand:" 
                   Foreground="White" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1"/>
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock Text=" Conquest - Phase 2" 
                   Foreground="#FFD4AF37" 
                   FontSize="20" 
                   FontStyle="Italic" 
                   Margin="10,0,0,0" 
                   VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!--Boutons du menu-->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Content="New Game" Style="{StaticResource MenuButtonStyle}" x:Name="btnNewGame" Click="btnNewGame_Click">
                <Button.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.5" ShadowDepth="2"/>
                </Button.Effect>
            </Button>

            <Button Content="Load Game" Style="{StaticResource MenuButtonStyle}" x:Name="btnLoadGame">
                <Button.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.5" ShadowDepth="2"/>
                </Button.Effect>
            </Button>

            <Button Content="Quit" Style="{StaticResource MenuButtonStyle}" x:Name="btnQuit" >
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF441111" Offset="0"/>
                        <GradientStop Color="#FFC0392B" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </StackPanel>



    </Grid>

</Window>
