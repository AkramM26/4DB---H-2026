<Window x:Class="HugoLand.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HugoLand Conquest" Height="500" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Base button style -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Width" Value="260"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#888888"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quit button style (accent) -->
        <Style x:Key="QuitButton" TargetType="Button" BasedOn="{StaticResource MenuButton}">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Title -->
            <TextBlock Text="HUGOLAND"
                       FontFamily="Segoe UI"
                       FontSize="28"
                       FontWeight="Light"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>
            <TextBlock Text="CONQUEST"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#555555"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>
        Title="HugoLand Conquest" Height="420" Width="500"
        WindowStartupLocation="CenterScreen">


    <Window.Background>
        <ImageBrush ImageSource="/img/MainWidowImg.png"/>
    </Window.Background>

    <Window.Resources>
        <Style TargetType="Button">
                <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value >
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MyBorder"                                     
                            BorderThickness="3"
                            CornerRadius="15"
                            Background="Transparent">
                            <Border.BorderBrush>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="Black"/>
                                    <GradientStop Color="White" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <ContentPresenter
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="MyBorder" Value="Gray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>



    <Grid Margin="10,20,10,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

            <!-- Menu buttons -->
            <Button x:Name="btnNewGame"            Content="New Game"                Style="{StaticResource MenuButton}" Click="btnNewGame_Click"/>
            <Button x:Name="btnNewGameWithTemplate" Content="New Game With Template"  Style="{StaticResource MenuButton}" Click="btnNewGameWithTemplate_Click"/>
            <Button x:Name="btnLoadGame"           Content="Load Game"               Style="{StaticResource MenuButton}" Click="btnLoadGame_Click"/>
            <Button x:Name="btnMapTemplate"        Content="Create Map Template"      Style="{StaticResource MenuButton}" Click="btnMapTemplate_Click"/>
            <Button x:Name="btnMapTemplateList"    Content="Edit Map Template"        Style="{StaticResource MenuButton}" Click="btnMapTemplateList_Click"/>
            <Button x:Name="btnQuit"               Content="Quit"                     Style="{StaticResource QuitButton}" Click="btnQuit_Click"/>

        </StackPanel>
    </Grid>
</Window>
