<Window x:Name="winEndGameReport" x:Class="HugoLand.WPF.EndGameReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HugoLand.WPF"
        mc:Ignorable="d"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="EndGameReport" Height="759" Width="808">

    <!--<Window.DataContext>
        -->
    <!-- "Cherche la source de données pour cette fenêtre" -->
    <!--
        <local:MainViewModel />
        -->
    <!-- "Crée une nouvelle instance de la classe MainViewModel" -->
    <!--
    </Window.DataContext>-->
    <!-- "Désormais, tout ce qui est dans cette fenêtre peut 'voir' les propriétés du ViewModel" -->


    <Grid x:Name="grdEndReport">
        <Grid x:Name="grdPlayersStats" Margin="73,278,47,0" Height="454" VerticalAlignment="Top">
            <StackPanel x:Name="spPlayer1Info" Margin="10,51,363,0">
                <TextBlock x:Name="tbP1Report" TextWrapping="Wrap" Height="166"><Run Language="fr-ca" Text="Report Informations  ..." Foreground="Black" FontWeight="DemiBold"/></TextBlock>
                <Grid Height="225" Width="314">
                    <TextBlock Text="Report" 
                               FontSize="24" 
                               HorizontalAlignment="Center" 
                               Margin="0,20" />

                    <lvc:CartesianChart Series="{Binding Series}" 
                        Margin="20,20,20,10" />
                </Grid>
            </StackPanel>
            <StackPanel x:Name="spPlayer2Info" Margin="327,51,10,0">
                <TextBlock x:Name="tbP2Report" TextWrapping="Wrap" Height="166"><Run Language="fr-ca" Text="Report Informations  ..." Foreground="Black" FontWeight="DemiBold"/></TextBlock>
                <Grid Height="217" Width="354">
                    <TextBlock Text="Report" 
                               FontSize="24" 
                               HorizontalAlignment="Center" 
                               Margin="0,20" />

                    <lvc:CartesianChart Series="{Binding Series2}" 
                        Margin="20,20,60,2" />
                </Grid>
            </StackPanel>
            <Label x:Name="lblPlayer1Title" Content="Player 1 " HorizontalAlignment="Left" Margin="10,22,0,0" VerticalAlignment="Top" Width="104" FontWeight="Bold" Foreground="#FF0C0101"/>
            <Label x:Name="lblPlayer2Title" Content="Player 2 " HorizontalAlignment="Left" Margin="327,22,0,0" VerticalAlignment="Top" Width="104" FontWeight="Bold" Foreground="#FF0C0101"/>
        </Grid>
        <TextBlock x:Name="tbTitle" HorizontalAlignment="Left" Margin="270,23,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="37" Width="204" FontSize="24" ><Run Language="fr-ca" Text="End Game Report"/></TextBlock>
        <TextBlock x:Name="txtStats" HorizontalAlignment="Left" Margin="63,99,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Height="174" Width="478"/>

    </Grid>
</Window>
