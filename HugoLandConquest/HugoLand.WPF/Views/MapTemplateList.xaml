<Window x:Class="HugoLand.WPF.Views.MapTemplateList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HugoLand.WPF.Views"
        mc:Ignorable="d"
        Title="Map Templates" Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        TextElement.Foreground="#E0E0E0">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Map Templates"
                   FontFamily="Segoe UI" FontSize="18" FontWeight="Light"
                   Foreground="#FFFFFF" Margin="0,0,0,14"/>

        <ListBox Grid.Row="1" x:Name="lstMap" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="3" Margin="2,3" Padding="10,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Edit"   Click="Edit_Click"   Tag="{Binding Id}" Margin="6,0,0,0" Width="70"/>
                                <Button Content="Delete" Click="Delete_Click" Tag="{Binding Id}" Margin="6,0,0,0" Width="70"
                                        Foreground="#CC6666"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding GameName}"        FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding GameDescription}" Foreground="#888888"  FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2" Content="Go to Main Menu" HorizontalAlignment="Left"
                Width="160" Margin="0,12,0,0" Click="Button_Click"/>
    </Grid>
</Window>
