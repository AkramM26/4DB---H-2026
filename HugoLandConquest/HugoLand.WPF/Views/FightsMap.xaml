<Window x:Class="HugoLand.WPF.Views.FightsMap"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HugoLand.WPF.Views"
        mc:Ignorable="d"
        Title="FightsMap" Height="402" Width="800">
    <Grid>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Border x:Name="brdTurnBanner" Background="#000014" Padding="8" Margin="0,0,0,6" CornerRadius="4">
                <StackPanel>
                    <TextBlock x:Name="txtTurnBanner" FontSize="18" FontWeight="Bold" Foreground="White"
                       Text="Map Fights statistics" TextWrapping="Wrap"/>
                    <TextBlock x:Name="txtTurnPrompt" FontSize="12" Foreground="White"
                       Text="Let's see what really happen " TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <!-- Board -->
        <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="3" Margin="0,61,0,3">
            <Grid x:Name="grdBoard"/>
        </Border>

    </Grid>
</Window>
