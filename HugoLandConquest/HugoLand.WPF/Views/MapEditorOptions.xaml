<Window x:Class="HugoLand.WPF.Views.MapEditorOptions"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HugoLand.WPF.Views"
        mc:Ignorable="d"
        Title="MapEditorOptions" Height="450" Width="800">
    <Grid>
        <Button x:Name="btnCreateMap" Content="Create Map" HorizontalAlignment="Center" Height="66" Margin="0,287,0,0" VerticalAlignment="Top" Width="224" Click="btnCreateMap_Click"/>
        <TextBox x:Name="txtGameSizeX" HorizontalAlignment="Left" Height="25" Margin="491,75,0,0" TextWrapping="Wrap" Text="10" VerticalAlignment="Top" Width="41"/>
        <Label Content="Game size X (Max 50, Min 10)" HorizontalAlignment="Center" Height="25" Margin="0,75,0,0" VerticalAlignment="Top" Width="178"/>
        <Label Content="Game size Y (Max 50, Min 10):" HorizontalAlignment="Center" Height="25" Margin="0,115,0,0" VerticalAlignment="Top" Width="177"/>
        <TextBox x:Name="txtGameSizeY" HorizontalAlignment="Left" Height="25" Margin="491,115,0,0" TextWrapping="Wrap" Text="10" VerticalAlignment="Top" Width="41"/>
        <Label Content="Unique Template Name :" HorizontalAlignment="Center" Height="25" Margin="0,145,0,0" VerticalAlignment="Top" Width="151"/>
        <TextBox x:Name="txtGameName" HorizontalAlignment="Left" Height="25" Margin="491,145,0,0" TextWrapping="Wrap" Text="Game Name" VerticalAlignment="Top" Width="174"/>

    </Grid>
</Window>
