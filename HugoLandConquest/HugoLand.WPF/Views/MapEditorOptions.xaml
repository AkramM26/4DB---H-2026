<Window x:Class="HugoLand.WPF.Views.MapEditorOptions"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HugoLand.WPF.Views"
        mc:Ignorable="d"
        Title="MapEditorOptions" Height="450" Width="800">
    <Grid>
        <Button x:Name="btnCreateMap" Content="Create Map" HorizontalAlignment="Left" Height="66" Margin="288,287,0,0" VerticalAlignment="Top" Width="224" Click="btnCreateMap_Click"/>
        <TextBox x:Name="txtGameSizeX" HorizontalAlignment="Left" Height="25" Margin="491,75,0,0" TextWrapping="Wrap" Text="10" VerticalAlignment="Top" Width="41"/>
        <Label Content="Game size X (Max 50, Min 10)" Height="25" Margin="311,75,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="178"/>
        <Label Content="Game size Y (Max 50, Min 10):" Height="25" Margin="312,115,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="176"/>
        <TextBox x:Name="txtGameSizeY" HorizontalAlignment="Left" Height="25" Margin="491,115,0,0" TextWrapping="Wrap" Text="10" VerticalAlignment="Top" Width="41"/>
        <Label Content="Unique Template Name :" Height="25" Margin="324,145,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="152"/>
        <TextBox x:Name="txtGameName" HorizontalAlignment="Left" Height="25" Margin="491,145,0,0" TextWrapping="Wrap" Text="Game Name" VerticalAlignment="Top" Width="174"/>
        <Label Content="Description (optional) :" HorizontalAlignment="Left" Height="25" Margin="324,175,0,0" VerticalAlignment="Top" Width="152"/>
        <TextBox x:Name="txtGameDescription" HorizontalAlignment="Left" Height="25" Margin="491,175,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="174"/>
        <Button Content="Cancel" HorizontalAlignment="Left" Height="66" Margin="561,287,0,0" VerticalAlignment="Top" Width="185" Click="Button_Click"/>

    </Grid>
</Window>
