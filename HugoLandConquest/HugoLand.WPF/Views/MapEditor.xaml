<Window x:Class="HugoLand.WPF.Views.MapEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HugoLand.WPF.Views"
        mc:Ignorable="d"
        Title="Map Editor" Height="560" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        TextElement.Foreground="#E0E0E0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Map canvas -->
        <Grid x:Name="grdMap" Grid.Row="0" Margin="10"/>

        <!-- Bottom toolbar -->
        <Border Grid.Row="1" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="12,10">
            <DockPanel>
                <!-- Action buttons on the right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Confirm"        Width="100" Margin="0,0,8,0" Click="Button_Click"/>
                    <Button x:Name="btnCancel" Content="Delete Template" Width="120" Foreground="#CC6666" Click="btnCancel_Click"/>
                </StackPanel>

                <!-- Terrain / player radio buttons -->
                <WrapPanel VerticalAlignment="Center">
                    <RadioButton x:Name="radioPlain"    Content="Plain"           Margin="0,0,14,0"/>
                    <RadioButton x:Name="radioForest"   Content="Forest"          Margin="0,0,14,0"/>
                    <RadioButton x:Name="radioMountain" Content="Mountain"        Margin="0,0,14,0"/>
                    <RadioButton x:Name="radioOcean"    Content="Ocean"           Margin="0,0,14,0"/>
                    <RadioButton x:Name="radioPlayer1"  Content="Player 1 start"  Margin="0,0,14,0"/>
                    <RadioButton x:Name="radioPlayer2"  Content="Player 2 start"  Margin="0,0,0,0"/>
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
