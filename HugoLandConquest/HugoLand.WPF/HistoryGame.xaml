<Window x:Class="HugoLand.WPF.HistoryGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game History" Height="450" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        TextElement.Foreground="#E0E0E0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select a game:" FontWeight="Bold" Margin="0,0,0,8"/>
        <GroupBox x:Name="grpFiltres" Foreground="White" Header="Filtres" Margin="0,21,308,221" Grid.RowSpan="2">
            <Grid>
                <GroupBox x:Name="grpMap" Header="Maps" Margin="10,0,121,10">
                    <Grid>
                        <CheckBox x:Name="chkTemplate" Foreground="White" Content="Template" HorizontalAlignment="Left" Margin="11,10,0,0" VerticalAlignment="Top" Checked="Filters_Changed" Unchecked="Filters_Changed"/>
                        <CheckBox x:Name="chkNotTemplate" Foreground="White" Content="Not template" HorizontalAlignment="Center" Margin="0,42,0,0" VerticalAlignment="Top" Checked="Filters_Changed" Unchecked="Filters_Changed"/>
                    </Grid>
                </GroupBox>
                <GroupBox x:Name="grpResult" Header="Winner" Margin="153,0,10,10">
                    <Grid>
                        <CheckBox x:Name="chkPlayer1" Content="Player 1" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Checked="Filters_Changed" Unchecked="Filters_Changed"/>
                        <CheckBox x:Name="chkPlayer2" Content="Player 2" Foreground="White" HorizontalAlignment="Center" Margin="0,42,0,0" VerticalAlignment="Top" Checked="Filters_Changed" Unchecked="Filters_Changed"/>
                    </Grid>
                </GroupBox>
            </Grid>
        </GroupBox>
        <GroupBox x:Name="grpTri" Header="Tri" Foreground="White" Margin="365,21,28,221" Grid.RowSpan="2">
            <Grid>
                <RadioButton x:Name="optDate" Content="Date" HorizontalAlignment="Left" Tag="Date" Margin="23,10,0,0" VerticalAlignment="Top" Checked="optTri_Checked"/>
                <RadioButton Content="Tours" HorizontalAlignment="Left" Tag="Tours" Margin="23,30,0,0" VerticalAlignment="Top" Checked="optTri_Checked"/>
            </Grid>
        </GroupBox>

        <ListView Grid.Row="1" x:Name="lstGames" MouseDoubleClick="lstGames_DoubleClick" Margin="0,153,0,0">
            <ListView.Background>
                <ImageBrush ImageSource="/img/loading.jpg" Stretch="UniformToFill" Opacity="0.3"/>
            </ListView.Background>
            <!--<ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" Margin="4">
                        <TextBlock Text="{Binding SaveName}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Summary}" Foreground="#888888" FontSize="11"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>-->
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding GameName}"/>
                    <GridViewColumn Header="Map" DisplayMemberBinding="{Binding Map}"/>
                    <GridViewColumn Header="Date" DisplayMemberBinding="{Binding Date}"/>
                    <GridViewColumn Header="Winner number" DisplayMemberBinding="{Binding WinnerNumber}"/>
                    <GridViewColumn Header="Turns" DisplayMemberBinding="{Binding Turns}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnDetails" Content="Details" Width="80" Margin="0,0,8,0"
                    Style="{StaticResource GameButtonConfirm}"
                     IsDefault="True" Click="btnDetails_Click"/>
            <Button x:Name="btnCancel" Content="Cancel" Width="80"
                    Style="{StaticResource GameButtonCancel}"
                    Click="btnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
