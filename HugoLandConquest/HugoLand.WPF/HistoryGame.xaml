<Window x:Class="HugoLand.WPF.HistoryGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Load Game" Height="450" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        TextElement.Foreground="#E0E0E0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select a saved game:" FontWeight="Bold" Margin="0,0,0,8"/>

        <ListView Grid.Row="1" x:Name="lstGames" MouseDoubleClick="lstGames_DoubleClick">
            <ListView.Background>
                <ImageBrush ImageSource="/img/loading.jpg" Stretch="UniformToFill" Opacity="0.3"/>
            </ListView.Background>
            <!--<ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" Margin="4">
                        <TextBlock Text="{Binding SaveName}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Summary}" Foreground="#888888" FontSize="11"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>-->
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding GameName}"/>
                    <GridViewColumn Header="Map" DisplayMemberBinding="{Binding Map}"/>
                    <GridViewColumn Header="Date" DisplayMemberBinding="{Binding Date}"/>
                    <GridViewColumn Header="Winner number" DisplayMemberBinding="{Binding WinnerNumber}"/>
                    <GridViewColumn Header="Turns" DisplayMemberBinding="{Binding Turns}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnDetails" Content="Details" Width="80" Margin="0,0,8,0"
                    Style="{StaticResource GameButtonConfirm}"
                     IsDefault="True" Click="btnDetails_Click"/>
            <Button x:Name="btnCancel" Content="Cancel" Width="80"
                    Style="{StaticResource GameButtonCancel}"
                    Click="btnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
