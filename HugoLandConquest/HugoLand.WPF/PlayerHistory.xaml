<Window x:Class="HugoLand.WPF.PlayerHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Player History" Height="450" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        TextElement.Foreground="#E0E0E0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox x:Name="grpPlayers" Foreground="White" Header="Choose a player" Margin="0,21,308,253" Grid.RowSpan="2">
            <Grid>
                <ComboBox x:Name="cmbPlayer" HorizontalAlignment="Left" SelectedIndex="0" Margin="81,37,0,0" VerticalAlignment="Top" Width="120">
                    <ComboBoxItem Content="Player 1"/>
                    <ComboBoxItem Content="Player 2"/>
                </ComboBox>
            </Grid>
        </GroupBox>

        <TextBlock x:Name="txtPlayerhistory" HorizontalAlignment="Center" Foreground="Black" Margin="0,151,0,0" Grid.Row="1" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Height="180" Width="560">
            <TextBlock.Background>
                <ImageBrush ImageSource="/loading.jpg"/>
            </TextBlock.Background>
        </TextBlock>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnCancel" Content="Back" Width="80"
                    Style="{StaticResource GameButtonCancel}"
                    Click="btnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
